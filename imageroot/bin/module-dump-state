#!/bin/bash

#
# Copyright (C) 2022 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

set -e

if ! systemctl --user -q is-active opensign.service; then
    exit 0
fi

# MongoDB runs with authentication: log in as the root user of mongo.env,
# whose variables the container has
podman exec mongo-app sh -c 'mongodump --username "$MONGO_INITDB_ROOT_USERNAME" --password "$MONGO_INITDB_ROOT_PASSWORD" --authenticationDatabase admin --archive' > opensign.archive